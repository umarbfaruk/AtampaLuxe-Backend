generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(uuid())

  // OWNER
  vendorId        String

  // BASIC INFO
  name            String
  description     String
  category        String
  subcategory     String?

  // PRICING
  price           Float
  stock           Int      @default(0)

  // MEDIA
  image           String?
  video           String?

  // PRODUCT DETAILS
  brand           String?
  sku             String?

  // STATUS
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)

  // SEO
  tags            Json?

  // SHIPPING
  weight          Float?

  // RATINGS
  averageRating   Float    @default(0)
  totalReviews    Int      @default(0)

  // TIMESTAMPS
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}